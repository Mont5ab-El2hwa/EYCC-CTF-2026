from hashlib import sha256

p=82880337306360052550952380657384418102169134986290141696988204552000561657747
a=26413685284385555604181540288021678971301314378522544469879270355650843743231
b=10017655579196313780863100027113686719855502076415017585743221280232958057095
x=37991937053350834320678619330546903567320901767090609881924528835279022654346
y=28947208718252880061735762506756351277969075978732800286053352115837132331595
f=open('flag.txt','rb').read().strip()
d=ZZ.random_element(1,p)
u=ZZ.random_element(2,p)
e=EllipticCurve(GF(p),[a*u^4,b*u^6])
g=e(u^2*x,u^3*y)
q=d*g
k=sha256(int(d).to_bytes(32,'big')).digest()
s=k+sha256(k).digest()
c=bytes(v^^s[i] for i,v in enumerate(f))
print(f'p = {p}\ng = {tuple(map(ZZ,g.xy()))}\nq = {tuple(map(ZZ,q.xy()))}\nc = {c.hex()}')

